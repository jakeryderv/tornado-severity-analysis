{
  "config": {
    "name": "Onset",
    "formulation": "ordinal",
    "members": 3,
    "sampling": "partial",
    "weighting": "none",
    "optimizer": "Adam",
    "learning_rate": 0.001,
    "l2": 0.001,
    "dropout": 0.0
  },
  "input_columns": [
    "start_longitude",
    "start_latitude",
    "radar_tvs_count",
    "radar_mda_count",
    "radar_structure_count",
    "radar_max_shear_per_s",
    "radar_max_velocity_difference_knots",
    "radar_max_rotation_velocity_knots",
    "radar_max_reflectivity_dbz",
    "radar_max_vil_kg_m2",
    "warning_active_tornado_count",
    "warning_active_severe_count",
    "warning_tornado_lead_minutes",
    "month_sin",
    "month_cos",
    "hour_utc_sin",
    "hour_utc_cos",
    "missingindicator_radar_max_shear_per_s",
    "missingindicator_radar_max_velocity_difference_knots",
    "missingindicator_radar_max_rotation_velocity_knots",
    "missingindicator_radar_max_reflectivity_dbz",
    "missingindicator_radar_max_vil_kg_m2",
    "missingindicator_warning_tornado_lead_minutes"
  ],
  "classes": [
    "EF0",
    "EF1",
    "EF2",
    "EF3",
    "EF4",
    "EF5"
  ],
  "outputs": "six EF class probabilities",
  "preprocessor": "data/derived/onset_preprocessor.joblib",
  "custom_objects": "execute the Section 5 ordinal helper definitions before loading",
  "selection_basis": "retrospective validation strategy and controlled comparisons",
  "test_scored": false
}
